# =====================================================
# 本地開發（SQLite，零安裝）
# =====================================================
DATABASE_URL="file:./prisma/dev.db"

# =====================================================
# 生產（Vercel + Neon PostgreSQL）
# 把 DATABASE_URL 改成 Neon 的「Pooled connection」字串，例如：
# DATABASE_URL="postgresql://USER:PASSWORD@xxx-pooler.ap-southeast-1.aws.neon.tech/DB?sslmode=require"
# 程式會自動依「postgres 開頭」切換到 Neon driver adapter。
# =====================================================

# ===== 會員 Session（JWT 簽署密鑰，務必換成長隨機字串）=====
SESSION_SECRET="請更換為長隨機字串"

# ===== 管理員帳號（種子資料用；生產請設強密碼）=====
ADMIN_EMAIL="admin@difly.tw"
ADMIN_PASSWORD="admin1234"

# ===== LINE Login（OAuth 2.1 / OIDC）=====
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# 正式環境請改成 https://你的網域/api/auth/line/callback
LINE_CALLBACK_URL="http://localhost:3000/api/auth/line/callback"

# ===== 對外網址（前端使用）=====
NEXT_PUBLIC_APP_URL="http://localhost:3000"
